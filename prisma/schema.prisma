generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id             String   @id @default(cuid())
  name           String
  price          Int
  originalPrice  Int?
  images         String[]
  category       String
  subCategory    String?
  colors         String[]
  sizes          String[]
  inStock        Boolean  @default(true)
  isNew          Boolean  @default(true)
  isSale         Boolean  @default(false)
  isBlindBox     Boolean  @default(false)
  collectionSlug String   @default("essentials")
  description    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id           String      @id
  customerName String
  email        String?
  phone        String?
  address      String
  total        Int
  status       String      @default("Pending")
  date         String
  createdAt    DateTime    @default(now())
  items        OrderItem[]
}

model OrderItem {
  id       String @id @default(cuid())
  orderId  String
  order    Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  name     String
  price    Int
  image    String
  size     String
  color    String
  quantity Int
}

model User {
  id        String @id @default(cuid())
  name      String
  email     String? @unique
  phone     String? @unique
  role      String  @default("customer")
  createdAt String
}
